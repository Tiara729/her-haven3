function art(p){return '<div class="tile" style="background:'+p.color+'"><svg viewBox="0 0 100 100" fill="#4A2040" aria-hidden="true">'+S[p.shape]+'</svg></div>'}
function gbp(n){return '£'+n.toFixed(2)}
var cart={}, cat="All", view="cart", order=null;
try{var saved=JSON.parse(localStorage.getItem("lp-cart")||"{}");if(saved&&typeof saved==="object")cart=saved}catch(e){}
function persist(){try{localStorage.setItem("lp-cart",JSON.stringify(cart))}catch(e){}}
function find(id){return P.filter(function(p){return p.id==id})[0]}
function items(){return Object.keys(cart).map(function(k){var c=cart[k],p=c&&find(c.id);return p?{k:k,p:p,q:c.q,colour:c.colour||"",note:c.note||"",u:c.u==null?p.price:c.u}:null}).filter(Boolean)}
function totals(){var sub=0,n=0;items().forEach(function(i){sub+=tp(i.p,i.q,i.u);n+=i.q});var ship=sub===0||sub>=FREE_OVER?0:SHIP;return{sub:sub,n:n,ship:ship,total:sub+ship}}
var SW={Pink:"#F7A8CE",Lilac:"#CDB4F5",Black:"#222",Brown:"#7A4B32",Nude:"#E8C4A8",White:"#fff",Gold:"#D4AF37",Silver:"#C0C0C8",Red:"#D3202E",Blue:"#3B6FD8","Leopard print":"#C98E3A"};
function tp(p,q,u){var t=(p.t||[]).concat([[1,u==null?p.price:u]]),c=[0],i,j;for(i=1;i<=q;i++){c[i]=1e9;for(j=0;j<t.length;j++)if(t[j][0]<=i)c[i]=Math.min(c[i],c[i-t[j][0]]+t[j][1])}return Math.round(c[q]*100)/100}
function grps(p){return p.c?p.c.g:[]}
function hasNote(p){return false}
function mu(){var u=cur.price;grps(cur).forEach(function(g,i){if(g.p)u=g.p[ms[i]||0]});return u}

function toast(t){var e=document.getElementById("toast");e.textContent=t;e.classList.add("show");clearTimeout(toast.h);toast.h=setTimeout(function(){e.classList.remove("show")},1600)}
function addCart(id,colour,note,q,u){var k=id+"|"+colour+"|"+note;if(cart[k])cart[k].q+=q;else cart[k]={id:id,q:q,colour:colour,note:note,u:u};persist();view="cart";renderDrawer();toast("Added to basket")}
function modalOpen(){return document.getElementById("modal").classList.contains("open")}
function closeM(){document.getElementById("modal").classList.remove("open");document.getElementById("mscrim").classList.remove("open");if(lastBtn)lastBtn.focus()}
function renderM(f){
  document.getElementById("modal").innerHTML='<div class="dh"><h2>Customise</h2><button class="x" id="mclose">Close</button></div><div class="mh">'+art(cur)+'<div><strong>'+cur.name+'</strong><div class="price">'+gbp(tp(cur,mq,mu()))+'</div></div></div>'+grps(cur).map(function(g,gi){return '<span class="mlabel">'+g.n+'</span><div class="sw">'+g.v.map(function(v,vi){return '<button class="swb" data-g="'+gi+'" data-v="'+vi+'" aria-pressed="'+((ms[gi]||0)===vi)+'">'+(SW[v]?'<i style="background:'+SW[v]+'"></i>':'')+v+'</button>'}).join("")+'</div>'}).join("")+(hasNote(cur)?'<label for="m-note" class="mlabel">Anything else? Size, length, name or initials, design</label><textarea id="m-note" rows="3" placeholder="e.g. size small, initial L, long almond shape">'+esc(mn)+'</textarea>':'')+'<div class="mrow"><div class="qty"><button id="mminus" aria-label="Fewer">−</button><span>'+mq+'</span><button id="mplus" aria-label="More">+</button></div><button class="btn" id="madd" style="margin:0;flex:1">Add to basket – '+gbp(tp(cur,mq,mu()))+'</button></div>';

    title.textContent="Your basket";
    var it=items();
    body.innerHTML=it.length?it.map(function(i){return '<div class="line">'+art(i.p)+'<div><strong>'+i.p.name+'</strong>'+(i.colour||i.note?'<small style="display:block;color:var(--muted)">'+esc(i.colour+(i.colour&&i.note?": ":"")+i.note)+'</small>':'')+'<div class="qty"><button data-dec="'+encodeURIComponent(i.k)+'" aria-label="Remove one">−</button><span>'+i.q+'</span><button data-inc="'+encodeURIComponent(i.k)+'" aria-label="Add one">+</button></div></div><div style="text-align:right">'+gbp(tp(i.p,i.q,i.u))+(tp(i.p,i.q,i.u)<i.u*i.q-.005?'<small style="display:block;color:var(--accent)">Save '+gbp(i.u*i.q-tp(i.p,i.q,i.u))+'</small>':'')+'</div></div>'}).join(""):'<p class="empty">Your basket is empty. Add something from the shop.</p>';
    foot.innerHTML='<div class="sum"><div><span>Subtotal</span><span>'+gbp(t.sub)+'</span></div><div><span>Delivery</span><span>'+(t.sub===0?"–":t.ship===0?"Free":gbp(t.ship))+'</span></div>'+(t.sub>0&&t.ship>0?'<small>Add '+gbp(FREE_OVER-t.sub)+' more for free delivery.</small>':'')+'<div class="t"><span>Total</span><span>'+gbp(t.total)+'</span></div></div><button class="btn" id="tocheckout"'+(t.n?'':' disabled')+'>Checkout</button>';
  }else if(view==="checkout"){
    title.textContent="Checkout";
    body.innerHTML='<p class="note">Demo only: no payment is taken and nothing is sent. A real store would hand payment to Stripe here.</p><label>Full name<input id="f-name" autocomplete="name"></label><label>Email<input id="f-email" type="email" autocomplete="email"></label><label>Delivery address<input id="f-addr" autocomplete="street-address"></label><label>Postcode<input id="f-post" autocomplete="postal-code"></label><div class="err" id="err" role="alert"></div>';
    foot.innerHTML='<div class="sum"><div class="t"><span>Total</span><span>'+gbp(t.total)+'</span></div></div><button class="btn" id="place">Place order</button><button class="x" id="back" style="width:100%;margin-top:8px;padding:10px">Back to basket</button>';
  }else{
    title.textContent="Order placed";
    body.innerHTML='<p><strong>Thanks, '+order.name.replace(/[<>&]/g,"")+'.</strong></p><p>Your order <strong>'+order.ref+'</strong> for '+gbp(order.total)+' is confirmed. A confirmation would be emailed to '+order.email.replace(/[<>&]/g,"")+'.</p>';
    foot.innerHTML='<button class="btn" id="done">Keep shopping</button>';
  }
}
function openD(){document.getElementById("drawer").classList.add("open");document.getElementById("scrim").classList.add("open");renderDrawer();document.getElementById("close").focus()}
function closeD(){document.getElementById("drawer").classList.remove("open");document.getElementById("scrim").classList.remove("open");if(view==="done")view="cart";document.getElementById("open").focus()}
document.addEventListener("click",function(e){
  var el=e.target.closest("button");if(!el)return;
  if(el.dataset.cat){cat=el.dataset.cat;renderShop();return}
  if(el.dataset.cq){var a=el.dataset.cq.split(","),qid=a[0],qn=Math.min(99,Math.max(1,(qs[qid]||1)+(+a[1])));qs[qid]=qn;document.getElementById("cq"+qid).textContent=qn;var pe=document.getElementById("pr"+qid);if(!pe.dataset.f)pe.textContent=gbp(tp(find(qid),qn));return}
  if(el.dataset.add){var pp=find(el.dataset.add);if(pp.c&&pp.c.g.length)openM(pp,el);else addCart(pp.id,"","",qs[pp.id]||1);return}
  if(el.dataset.cust){openM(find(el.dataset.cust),el);return}
  if(el.dataset.g!==undefined){ms[+el.dataset.g]=+el.dataset.v;renderM('[data-g="'+el.dataset.g+'"][data-v="'+el.dataset.v+'"]');return}
  if(el.id==="mclose"){closeM();return}
  if(el.id==="mminus"){if(mq>1)mq--;renderM("#mminus");return}
  if(el.id==="mplus"){mq++;renderM("#mplus");return}
  if(el.id==="madd"){var sel=grps(cur).map(function(g,i){return g.v[ms[i]||0]}).filter(function(v){return v!=="As shown"}).join(", ");addCart(cur.id,sel,hasNote(cur)?mn.trim():"",mq,mu());closeM();return}
  if(el.dataset.inc){var k1=decodeURIComponent(el.dataset.inc);if(cart[k1]){cart[k1].q++;persist();renderDrawer()}return}
  if(el.dataset.dec){var k2=decodeURIComponent(el.dataset.dec);if(cart[k2]){cart[k2].q--;if(cart[k2].q<=0)delete cart[k2];persist();renderDrawer()}return}
  if(el.id==="open"){view="cart";openD();return}
  if(el.id==="close"){closeD();return}
  if(el.id==="tocheckout"){startCheckout(el);return}
  if(el.id==="back"){view="cart";renderDrawer();return}
  if(el.id==="done"){closeD();return}
  if(el.id==="place"){
    var n=document.getElementById("f-name").value.trim(),m=document.getElementById("f-email").value.trim(),a=document.getElementById("f-addr").value.trim(),pc=document.getElementById("f-post").value.trim();
    if(!n||!/^\S+@\S+\.\S+$/.test(m)||!a||!pc){document.getElementById("err").textContent="Enter your name, a valid email, address and postcode to continue.";return}
    order={name:n,email:m,ref:"HH-"+Math.floor(10000+Math.random()*89999),total:totals().total};
    cart={};persist();view="done";renderDrawer();
  }
});
document.getElementById("scrim").addEventListener("click",closeD);
document.getElementById("mscrim").addEventListener("click",closeM);
document.addEventListener("input",function(e){if(e.target.id==="m-note")mn=e.target.value});
document.addEventListener("keydown",function(e){if(e.key==="Escape"){if(modalOpen())closeM();else closeD()}});
function startCheckout(btn){btn.disabled=true;btn.textContent="Taking you to payment...";fetch("/api/checkout",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({items:items().map(function(i){return{id:i.p.id,colour:i.colour,q:i.q}})})}).then(function(r){return r.json()}).then(function(d){if(d.url)location.href=d.url;else throw new Error(d.error||"Checkout failed")}).catch(function(e){btn.disabled=false;btn.textContent="Checkout";toast(e.message||"Something went wrong")})}
if(/[?&]paid=1/.test(location.search)){cart={};persist();history.replaceState(null,"",location.pathname);setTimeout(function(){toast("Thank you! Your order is confirmed.")},300)}
renderShop();renderDrawer();
</script>
</body>

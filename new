<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Her Haven</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600&family=Nunito:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#FFF0F6;--surface:#fff;--ink:#4A2040;--muted:#8A5F7E;--line:#F5CDE0;--accent:#D12C7E;--accent-ink:#fff;--shade:rgba(74,32,64,.45)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#2A1426;--surface:#3A1D35;--ink:#FFE8F2;--muted:#D9A9C8;--line:#5A2E52;--accent:#FF8CC0;--accent-ink:#3A0F2A;--shade:rgba(0,0,0,.6)}}
:root[data-theme="dark"]{--bg:#2A1426;--surface:#3A1D35;--ink:#FFE8F2;--muted:#D9A9C8;--line:#5A2E52;--accent:#FF8CC0;--accent-ink:#3A0F2A;--shade:rgba(0,0,0,.6)}
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.5 "Nunito",system-ui,-apple-system,"Segoe UI",sans-serif}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:10}
h1,h2,h3,.brand{font-family:"Fredoka","Nunito",system-ui,sans-serif;margin:0}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;display:flex;align-items:center;justify-content:space-between;padding:14px clamp(16px,4vw,48px);background:var(--bg);border-bottom:1px solid var(--line)}
.brand{font-size:1.5rem;font-weight:700;letter-spacing:-.02em}
.cartbtn{display:flex;gap:10px;align-items:center;background:var(--ink);color:var(--bg);border:0;border-radius:999px;padding:10px 18px;font-weight:700}
.cartbtn span{background:var(--accent);color:var(--accent-ink);border-radius:999px;min-width:24px;padding:0 7px;text-align:center;font-size:.85rem}
.hero{padding:clamp(40px,8vw,96px) clamp(16px,4vw,48px) 24px;max-width:1200px;margin:0 auto}
.hero h1{font-size:clamp(2.6rem,8vw,6rem);line-height:1;letter-spacing:-.01em;font-weight:600;max-width:12ch}
.hero p{color:var(--muted);max-width:46ch;margin:20px 0 0;font-size:1.1rem}
.bar{max-width:1200px;margin:24px auto 0;padding:0 clamp(16px,4vw,48px);display:flex;gap:8px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:8px 16px}
.chip[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.grid{max-width:1200px;margin:24px auto 64px;padding:0 clamp(16px,4vw,48px);display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:24px;overflow:hidden;display:flex;flex-direction:column}
.tile{aspect-ratio:1/1;display:grid;place-items:center}
.tile svg{width:58%;height:58%}
.info{padding:14px 16px 16px;display:flex;flex-direction:column;gap:4px;flex:1}
.info h3{font-size:1.1rem;font-weight:500}
.info small{color:var(--muted)}
.row{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:12px}
.price{font-weight:700;font-size:1.1rem}
.add{background:var(--accent);color:var(--accent-ink);border:0;border-radius:999px;padding:8px 14px;font-weight:700}
.scrim{position:fixed;inset:0;background:var(--shade);z-index:20;display:none}
.scrim.open{display:block}
aside{position:fixed;top:0;right:0;bottom:0;width:min(440px,100%);background:var(--surface);z-index:30;display:flex;flex-direction:column;padding:calc(20px + env(safe-area-inset-top,0px)) 20px calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(100%);visibility:hidden;transition:transform .25s}
aside.open{transform:none;visibility:visible}
@media (prefers-reduced-motion:reduce){aside,#toast{transition:none}}
.dh{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.dh h2{font-size:1.5rem}
.x{background:none;border:1px solid var(--line);border-radius:8px;padding:6px 12px}
.body{flex:1;overflow:auto}
.line{display:grid;grid-template-columns:56px 1fr auto;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
.line .tile{aspect-ratio:1/1;border-radius:8px}
.qty{display:flex;align-items:center;gap:8px;margin-top:4px}
.qty button{width:28px;height:28px;border:1px solid var(--line);background:none;border-radius:6px}
.sum{padding-top:14px;display:grid;gap:6px}
.sum div{display:flex;justify-content:space-between}
.sum .t{font-weight:700;font-size:1.2rem}
.btn{width:100%;margin-top:14px;background:var(--accent);color:var(--accent-ink);border:0;border-radius:10px;padding:14px;font-weight:700;font-size:1rem}
.btn:disabled{opacity:.45;cursor:not-allowed}
.empty{color:var(--muted);padding:32px 0}
label{display:grid;gap:4px;margin-bottom:12px;font-weight:500}
input{font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);width:100%}
.note{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px 12px;color:var(--muted);font-size:.9rem;margin-bottom:12px}
.err{color:#C0392B;font-size:.9rem;min-height:1.2em}
@media (prefers-color-scheme:dark){.err{color:#FF8A7A}}
.row{flex-wrap:wrap;gap:8px}.acts{display:flex;flex-wrap:wrap;align-items:center;gap:6px;width:100%}
.alt{background:none;border:1px solid var(--accent);color:var(--accent);border-radius:999px;padding:8px 12px;font-weight:700}
.modal{position:fixed;z-index:40;left:50%;top:50%;transform:translate(-50%,-50%);width:min(460px,calc(100% - 32px));max-height:calc(100% - 32px);overflow:auto;background:var(--surface);border-radius:24px;padding:20px;display:none}
.modal.open{display:block}
.mh{display:flex;gap:14px;align-items:center}.mh .tile{width:72px;border-radius:12px}
.mlabel{margin:14px 0 6px;font-weight:700;display:block}
.sw{display:flex;flex-wrap:wrap;gap:6px}
.swb{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:6px 12px}
.swb[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.swb i{display:inline-block;width:14px;height:14px;border-radius:50%;border:1px solid var(--line);margin-right:6px;vertical-align:-2px}
textarea{font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:var(--bg);color:var(--ink);width:100%;resize:vertical}
.mrow{display:flex;gap:12px;align-items:center;margin-top:16px}
#toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%) translateY(20px);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:999px;opacity:0;pointer-events:none;transition:.2s;z-index:50}
#toast.show{opacity:1;transform:translateX(-50%)}
footer{padding:24px clamp(16px,4vw,48px) 40px;color:var(--muted);text-align:center;border-top:1px solid var(--line)}
</style>
</head>
<body>
<header>
  <div class="brand">Her Haven</div>
  <button class="cartbtn" id="open" aria-label="Open basket">Basket <span id="count">0</span></button>
</header>
<main>
  <section class="hero">
    <h1>Pretty little things, just for you.</h1>
    <p>Lashes, press-on nails, makeup tools and hair essentials, all in one cute little shop. Free UK delivery on orders over £40.</p>
  </section>
  <div class="bar" id="chips" role="group" aria-label="Filter by category"></div>
  <section class="grid" id="grid" aria-live="polite"></section>
</main>
<footer>Her Haven. Secure card payments by Stripe.</footer>

<div class="scrim" id="scrim"></div>
<div class="scrim" id="mscrim" style="z-index:35"></div>
